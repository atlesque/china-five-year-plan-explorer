---
import { getCollection } from 'astro:content';
import IndustryGrid from '@/components/IndustryGrid.astro';
import PlanHero from '@/components/PlanHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { absoluteUrl } from '@/lib/seo';

const entries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
const description = 'Explore the industries, technologies, and systems shaped by China’s 15th Five-Year Plan (2026–2030).';
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Key industries and growth themes',
    itemListElement: entries.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.data.title,
      url: absoluteUrl(Astro.site, `/industries/${entry.data.slug}/`),
    })),
};
---

<BaseLayout description={description} jsonLd={jsonLd}>
  <PlanHero />
  <section class="industry-section shell" aria-labelledby="industry-section-title">
    <div class="section-heading-row">
      <div><p class="kicker">The impact map</p><h2 id="industry-section-title">Where the plan puts weight</h2></div>
      <p class="section-aside">{entries.length} industries and capabilities, grouped by the systems they help build.</p>
    </div>
    <IndustryGrid entries={entries} />
  </section>
</BaseLayout>
