---
import { getCollection } from 'astro:content';
import IndustryGrid from '@/components/IndustryGrid.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { absoluteUrl } from '@/lib/seo';

const entries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
const themeCount = entries.length;
const description = `Browse all ${themeCount} source-grounded industry and growth-theme pages in China’s 15th Five-Year Plan Explorer.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Industries | China’s 15th Five-Year Plan Explorer',
  description,
  url: absoluteUrl(Astro.site, '/industries/'),
  hasPart: entries.map((entry) => ({ '@type': 'WebPage', name: entry.data.title, url: absoluteUrl(Astro.site, `/industries/${entry.data.slug}/`) })),
};
---

<BaseLayout title="Industries" description={description} type="collection" jsonLd={jsonLd}>
  <section class="page-intro shell">
    <p class="kicker">Industry map / {themeCount} focus areas</p>
    <h1>The industries the plan is building toward.</h1>
    <p>Follow the plan from foundational capabilities to future industries, energy systems, connected infrastructure, and social demand.</p>
  </section>
  <section class="industry-section shell" aria-labelledby="directory-title">
    <h2 id="directory-title" class="sr-only">All industries and growth themes</h2>
    <IndustryGrid entries={entries} />
  </section>
</BaseLayout>
