---
import { sources } from '@/data/sources';
import { absoluteUrl, pageTitle, siteDescription, siteName, socialImagePath } from '@/lib/seo';
import JsonLd from '@/components/JsonLd.astro';
import SkipLink from '@/components/SkipLink.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import '../styles/app.css';

interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'collection';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  type = 'website',
  jsonLd,
} = Astro.props;
const documentTitle = pageTitle(title);
const canonical = absoluteUrl(Astro.site, Astro.url.pathname);
const siteUrl = absoluteUrl(Astro.site, '/');
const image = absoluteUrl(Astro.site, socialImagePath);
const imageAlt = "China's 15th Five-Year Plan Explorer — a source-grounded guide to strategic industries and growth themes";
const openGraphType = type === 'article' ? 'article' : 'website';
const structuredType = type === 'article' ? 'Article' : type === 'collection' ? 'CollectionPage' : 'WebPage';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}#organization`,
    name: siteName,
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: image },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: siteName,
    url: siteUrl,
    description: siteDescription,
    inLanguage: 'en',
    publisher: { '@id': `${siteUrl}#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': structuredType,
    '@id': canonical,
    name: documentTitle,
    headline: title ?? documentTitle,
    description,
    url: canonical,
    image,
    inLanguage: 'en',
    isPartOf: { '@id': `${siteUrl}#website` },
    publisher: { '@id': `${siteUrl}#organization` },
    citation: [sources.planZh.url, sources.planEn.url],
  },
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en" data-theme="observatory" data-color-mode="auto">
  <head>
    <script is:inline>
      const savedColorMode = localStorage.getItem('plan-color-mode');
      if (savedColorMode === 'light' || savedColorMode === 'dark' || savedColorMode === 'auto') {
        document.documentElement.dataset.colorMode = savedColorMode;
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta name="theme-color" content="#a83b2d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@alexatlesque" />
    <meta name="twitter:creator" content="@alexatlesque" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{documentTitle}</title>
    <slot name="head" />
    <JsonLd data={structuredData} />
  </head>
  <body>
    <SkipLink />
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
