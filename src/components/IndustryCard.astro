---
import { sourceLabel } from '@/lib/sourceRefs';

interface Props {
  entry: {
    data: {
      slug: string;
      title: string;
      eyebrow: string;
      shortDescription: string;
      theme: 'cyan' | 'violet' | 'jade' | 'amber';
      sourceRefs: { sourceId: 'planZh' | 'planEn' }[];
    };
  };
  index: number;
}

const { entry, index } = Astro.props;
const data = entry.data;
const code = `0${index + 1}`.slice(-2);
---

<article class={`industry-card theme-${data.theme}`} data-index={code}>
  <a href={`/industries/${data.slug}/`} aria-label={`Explore ${data.title}`}>
    <span class="card-index" aria-hidden="true">{code}</span>
    <div class="card-main">
      <p class="card-eyebrow">{data.eyebrow}</p>
      <h3>{data.title}</h3>
      <p class="card-description">{data.shortDescription}</p>
    </div>
    <div class="card-side">
      <span class="card-source">{sourceLabel(data.sourceRefs[0].sourceId)}</span>
      <span class="card-cta">Open field <strong aria-hidden="true">↗</strong></span>
    </div>
  </a>
</article>
