---
import { sources } from '@/data/sources';
import ExternalSourceLink from './ExternalSourceLink.astro';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="kicker">Source-grounded discovery</p>
      <p class="footer-title">Reading the plan as a map of directed attention.</p>
      <p class="footer-note">This explorer describes where the plan directs attention, investment, infrastructure, research, or policy support. It is not an investment recommendation or an independent forecast.</p>
    </div>
    <div class="footer-column">
      <p class="kicker">Primary documents</p>
      <ExternalSourceLink href={sources.planZh.url} label="Official Chinese original (PDF)" />
      <ExternalSourceLink href={sources.planEn.url} label="English translation (PDF)" />
      <a class="footer-text-link" href="/sources/">Sources and methodology →</a>
    </div>
    <div class="footer-column footer-meta">
      <p class="kicker">Plan period</p>
      <p>2026–2030</p>
      <p class="footer-small">The Chinese original is authoritative. The English PDF is the translation used for this MVP.</p>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>China’s 15th Five-Year Plan Explorer</span>
    <span>Editorial MVP · 2026</span>
  </div>
</footer>
