---
import { sources } from '@/data/sources';
import ExternalSourceLink from './ExternalSourceLink.astro';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="kicker">China’s 15th Five-Year Plan</p>
      <p class="footer-title">A map of industrial impact.</p>
      <p class="footer-note">Editorial summaries of the plan’s named industries, technologies, and systems.</p>
    </div>
    <div class="footer-column">
      <p class="kicker">Primary documents</p>
      <ExternalSourceLink href={sources.planZh.url} label="Official Chinese original (PDF)" />
      <ExternalSourceLink href={sources.planEn.url} label="English translation (PDF)" />
      <a class="footer-text-link" href="/sources/">Sources and method →</a>
    </div>
    <div class="footer-column footer-meta">
      <p class="kicker">Plan period</p>
      <p>2026–2030</p>
      <p class="footer-small">The Chinese original is authoritative.</p>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>China’s 15th Five-Year Plan Explorer</span>
    <span>17 March 2026</span>
  </div>
</footer>
