<button class="theme-toggle" type="button" data-theme-toggle aria-label="Automatic theme active. Switch to light theme" title="Automatic theme active. Switch to light theme">
  <svg class="theme-icon theme-icon--auto" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="4" y="4" width="16" height="13" rx="1.5" />
    <path d="M8 20h8M12 17v3" />
  </svg>
  <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.2 15.3A8.4 8.4 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z" />
  </svg>
</button>

<script is:inline>
  const root = document.documentElement;
  const toggle = document.querySelector('[data-theme-toggle]');
  const modes = ['auto', 'dark', 'light'];
  const modeLabels = {
    auto: 'Automatic theme',
    light: 'Light theme',
    dark: 'Dark theme',
  };

  const setMode = (mode, persist = true) => {
    const nextMode = modes.includes(mode) ? mode : 'auto';
    const nextChoice = modes[(modes.indexOf(nextMode) + 1) % modes.length];
    root.dataset.colorMode = nextMode;
    if (persist) localStorage.setItem('plan-color-mode', nextMode);
    toggle?.setAttribute('aria-label', `${modeLabels[nextMode]} active. Switch to ${modeLabels[nextChoice].toLowerCase()}`);
    toggle?.setAttribute('title', `${modeLabels[nextMode]} active. Switch to ${modeLabels[nextChoice].toLowerCase()}`);
  };

  toggle?.addEventListener('click', () => {
    const currentIndex = modes.indexOf(root.dataset.colorMode || 'auto');
    setMode(modes[(currentIndex + 1) % modes.length]);
  });

  setMode(root.dataset.colorMode || 'auto', false);
</script>
