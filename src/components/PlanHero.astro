---
import { sources } from '@/data/sources';
import ExternalSourceLink from './ExternalSourceLink.astro';
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="kicker"><span class="signal-dot" aria-hidden="true"></span> National development outline · 2026–2030</p>
    <h1 id="hero-title">China’s 15th<br /><em>Five-Year Plan</em></h1>
    <p class="hero-deck">A clear, source-grounded way to explore the industries, infrastructure, capabilities, and social priorities named in China’s national development outline.</p>
    <div class="hero-actions" aria-label="Primary source documents">
      <ExternalSourceLink href={sources.planZh.url} label="Open Chinese original" />
      <ExternalSourceLink href={sources.planEn.url} label="Open English translation" />
    </div>
    <p class="hero-note">The Chinese original is authoritative. The English PDF is the translation used for this site.</p>
  </div>
  <div class="hero-visual" aria-hidden="true">
    <div class="hero-seal">纲</div>
    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>
    <div class="orb orb-three"></div>
    <div class="hero-grid-lines"></div>
    <div class="hero-coordinate">31°N / 121°E<br /><span>STRATEGIC HORIZON</span></div>
    <div class="hero-vertical-label">国家发展规划 / NATIONAL DEVELOPMENT</div>
  </div>
</section>
